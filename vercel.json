{
"$schema": "https://openapi.vercel.sh/vercel.json",
"cleanUrls": true,
"trailingSlash": false,
"rewrites": [
{
"source": "/(.)",
"destination": "/index.html"
}
],
"headers": [
{
"source": "/(.)",
"headers": [
{
"key": "Referrer-Policy",
"value": "no-referrer-when-downgrade"
},
{
"key": "X-Content-Type-Options",
"value": "nosniff"
}
]
}
]
}
